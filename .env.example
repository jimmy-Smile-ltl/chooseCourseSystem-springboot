# 复制为 .env 或直接配置到部署平台的环境变量中
DATABASE_URL=jdbc:postgresql://<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&prepareThreshold=0
DB_USER=<neon-user>
DB_PASSWORD=<neon-password>

# 可选：Flyway 使用 direct 连接（去掉 -pooler）
SPRING_FLYWAY_URL=jdbc:postgresql://<project>.<region>.aws.neon.tech/<db>?sslmode=require
SPRING_FLYWAY_USER=<neon-user>
SPRING_FLYWAY_PASSWORD=<neon-password>

SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_POOL_SIZE=5
THYMELEAF_CACHE=true
